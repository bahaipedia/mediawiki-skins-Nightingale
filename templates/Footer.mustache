{{! `role` is unnecessary but kept to support selectors in any gadgets or user styles and
	to mitigate a VoiceOver bug. }}
<footer id="footer" class="mw-footer" role="contentinfo" {{{html-user-language-attributes}}}>
    <div class="nightingale-footer-inner">
        {{! Tier 1: Document Colophon & Page Tools }}
        <div class="nightingale-footer-colophon">
            <div class="nightingale-colophon-meta">
                {{#data-footer}}
                    {{#data-last-modified}}{{>LastModifiedLine}}{{/data-last-modified}}
                {{/data-footer}}
            </div>

            <div class="nightingale-footer-tools">
                {{#nightingale-footer-portlets}}
                    <div class="mw-portlet mw-portlet-dropdown nightingale-dropup">
                        <input type="checkbox" id="cb-foot-{{id}}" class="mw-checkbox-hack-checkbox">
                        <label for="cb-foot-{{id}}" class="mw-checkbox-hack-button">{{label}} <span class="dropup-caret">▴</span></label>
                        <div class="mw-portlet-body">
                            <ul>
                                {{#array-items}}{{>ListItem}}{{/array-items}}
                            </ul>
                        </div>
                    </div>
                {{/nightingale-footer-portlets}}
                <a href="#" class="nightingale-back-to-top">↑ Top</a>
            </div>
        </div>

        {{! Tier 2: Global Site Footer }}
        {{#data-footer}}
        <div class="nightingale-footer-main">
            <div id="footer-list" class="nightingale-footer-info">
                {{#data-places}}{{>FooterList}}{{/data-places}}
                <div id="copyright">{{#data-copyright}}{{{html}}}{{/data-copyright}}</div>
            </div>
            {{#data-icons}}{{>FooterList}}{{/data-icons}}
        </div>
        {{/data-footer}}
    </div>
</footer>
